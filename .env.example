CANVAS_BASE_URL=https://<ur_school_name>.instructure.com 
CANVAS_ACCESS_TOKEN=you_canvas_access_token_here
# if your school blocks student tokens, leave CANVAS_ACCESS_TOKEN empty and paste the
# full Cookie request header from a logged in Canvas tab instead (expires, refresh when tools say so)
CANVAS_COOKIE=
POKE_API_KEY=your_api_key_here
# optional
TIMEZONE=America/New_York
# e.g. 26FS, only show courses whose dashboard name starts with this
DEFAULT_TERM_PREFIX=
